# Dependencies
node_modules/
# package-lock.json IS committed: compile.sh uses `npm ci` so every build resolves
# the exact same dependency tree (reproducible builds, no silent upstream drift).
yarn.lock
pnpm-lock.yaml

# Downloads
downloads/
*.mp4
*.mkv
*.webm
*.avi
*.mov
*.flv
*.m4v
*.ts

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

