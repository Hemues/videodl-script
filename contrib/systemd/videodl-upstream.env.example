# Host-specific settings for update-from-upstream.sh — copy to /etc/videodl-upstream.env
# (chmod 600, owned by root). This example holds placeholders only; the real file lives
# on the build host and is never committed (see .gitignore).
#
# Every value can also be passed as a normal environment variable; the file wins over
# the script's generic defaults, explicit env wins over the file.

# Checkout of Hemues/videodl-script on the build host (default: the script's own directory)
CLI_DIR=/path/to/videodl-script

# Checkout of Hemues/videodl-container (default: ../videodl-container next to CLI_DIR)
CONTAINER_DIR=/path/to/videodl-container

# Unprivileged user that runs the production (rootless podman) container
DEPLOY_USER=videodl

# The host's updater script that stops, pulls and restarts that container — REQUIRED for
# `run` unless --no-deploy is given (there is no safe generic default).
UPDATER=/path/to/your/videodl-updater-script

# Image name (without tag) as pushed to the registry
IMAGE=ghcr.io/hemues/videodl

# Where reports and smoke JSONs are written
STATE_DIR=/var/lib/videodl-upstream
