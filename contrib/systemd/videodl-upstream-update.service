[Unit]
Description=videodl: check yt-dlp/ejs upstream and roll a gated update through CLI + container
Documentation=https://github.com/Hemues/videodl-script/blob/main/UPDATE-FROM-YTDLP.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=HOME=/root
# Host-specific paths (checkout dirs, deploy user, updater script) live in this private
# file — copy contrib/systemd/videodl-upstream.env.example and fill it in.
EnvironmentFile=/etc/videodl-upstream.env
ExecStart=/usr/bin/bash -c 'exec "${CLI_DIR:?CLI_DIR must be set in /etc/videodl-upstream.env}/update-from-upstream.sh" run'
# exit 3 = "human action required" (client-table diff or red gate) — not a unit failure
SuccessExitStatus=0 3
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=idle
